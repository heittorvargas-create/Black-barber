</footer>

<!-- MODAL LOGIN -->
<div class="modal" id="modalLogin">
  <div class="modal-content">
    <button class="modal-close" onclick="fecharLogin()">&times;</button>
    <h2>ÁREA ADMIN</h2>
    <form onsubmit="fazerLogin(event)">
      <input type="text" id="loginUsuario" placeholder="Usuário" required>
      <input type="password" id="loginSenha" placeholder="Senha" required>
      <button type="submit" class="btn" style="width:100%">Entrar</button>
    </form>
  </div>
</div>

<!-- PAINEL ADMIN -->
<div class="admin-panel" id="adminPanel">
  <div class="admin-header">
    <h1>PAINEL ADMINISTRATIVO</h1>
    <button onclick="sairAdmin()">Sair</button>
  </div>
  <div class="admin-content">
    <!-- ESTATÍSTICAS -->
    <div class="stats-grid">
      <div class="stat-card">
        <h3>Saldo do Dia</h3>
        <div class="value" id="saldoDia">R$ 0</div>
      </div>
      <div class="stat-card">
        <h3>Saldo da Semana</h3>
        <div class="value" id="saldoSemana">R$ 0</div>
      </div>
      <div class="stat-card">
        <h3>Saldo do Mês</h3>
        <div class="value" id="saldoMes">R$ 0</div>
      </div>
      <div class="stat-card">
        <h3>Total de Agendamentos</h3>
        <div class="value" id="totalAgendamentos">0</div>
      </div>
    </div>

    <!-- GRÁFICOS -->
    <div class="charts-grid">
      <div class="chart-container">
        <h3>Faturamento por Período</h3>
        <canvas id="chartFaturamento"></canvas>
      </div>
      <div class="chart-container">
        <h3>Serviços Mais Procurados</h3>
        <canvas id="chartServicos"></canvas>
      </div>
    </div>

    <!-- AGENDAMENTOS PENDENTES -->
    <div class="agendamentos-section">
      <h2>AGENDAMENTOS PENDENTES</h2>
      <div id="listaPendentes"></div>
    </div>

    <!-- AGENDAMENTOS CONFIRMADOS -->
    <div class="agendamentos-section">
      <h2>AGENDAMENTOS CONFIRMADOS</h2>
      <div id="listaConfirmados"></div>
    </div>

    <!-- AGENDAMENTOS CONCLUÍDOS -->
    <div class="agendamentos-section">
      <h2>AGENDAMENTOS CONCLUÍDOS</h2>
      <div id="listaConcluidos"></div>
    </div>
  </div>
</div>

<script>
  // Menu mobile
  const toggle = document.getElementById('menuToggle');
  const navLinks = document.getElementById('navLinks');
  toggle.addEventListener('click', () => navLinks.classList.toggle('active'));
  document.querySelectorAll('.nav-links a').forEach(link => {
    link.addEventListener('click', () => navLinks.classList.remove('active'));
  });

  // Animação ao rolar
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('active');
    });
  }, { threshold: 0.15 });
  reveals.forEach(el => observer.observe(el));

  // BANCO DE DADOS (localStorage)
  function getAgendamentos() {
    return JSON.parse(localStorage.getItem('agendamentos') || '[]');
  }
  function saveAgendamentos(agendamentos) {
    localStorage.setItem('agendamentos', JSON.stringify(agendamentos));
  }

  // CRIAR AGENDAMENTO
  function criarAgendamento(e) {
    e.preventDefault();
    const nome = document.getElementById('nome').value;
    const telefone = document.getElementById('telefone').value;
    const servicoCompleto = document.getElementById('servico').value;
    const [servico, preco] = servicoCompleto.split('|');
    const data = document.getElementById('data').value;
    const hora = document.getElementById('hora').value;
    const observacoes = document.getElementById('observacoes').value;

    const agendamento = {
      id: Date.now(),
      nome,
      telefone,
      servico,
      preco: parseFloat(preco),
      data,
      hora,
      observacoes,
      status: 'pendente',
      criadoEm: new Date().toISOString()
    };

    const agendamentos = getAgendamentos();
    agendamentos.push(agendamento);
    saveAgendamentos(agendamentos);

    alert('Agendamento solicitado com sucesso! Aguarde a confirmação.');
    e.target.reset();
  }

  // LOGIN
  function abrirLogin(e) {
    e.preventDefault();
    document.getElementById('modalLogin').classList.add('active');
  }
  function fecharLogin() {
    document.getElementById('modalLogin').classList.remove('active');
  }
  function fazerLogin(e) {
    e.preventDefault();
    const usuario = document.getElementById('loginUsuario').value;
    const senha = document.getElementById('loginSenha').value;

    if (usuario === 'Heitor' && senha === '2105') {
      fecharLogin();
      document.getElementById('adminPanel').classList.add('active');
      carregarDashboard();
    } else {
      alert('Usuário ou senha incorretos!');
    }
  }
  function sairAdmin() {
    document.getElementById('adminPanel').classList.remove('active');
  }

  // VARIÁVEIS DOS GRÁFICOS
  let chartFaturamento = null;
  let chartServicos = null;

  // DASHBOARD
  function carregarDashboard() {
    const agendamentos = getAgendamentos();
    const hoje = new Date().toISOString().split('T')[0];
    
    const concluidos = agendamentos.filter(a => a.status === 'concluido');
    
    const saldoDia = concluidos
      .filter(a => a.data === hoje)
      .reduce((sum, a) => sum + a.preco, 0);
    
    const inicioSemana = new Date();
    inicioSemana.setDate(inicioSemana.getDate() - inicioSemana.getDay());
    const saldoSemana = concluidos
      .filter(a => new Date(a.data) >= inicioSemana)
      .reduce((sum, a) => sum + a.preco, 0);
    
    const inicioMes = new Date();
    inicioMes.setDate(1);
    const saldoMes = concluidos
      .filter(a => new Date(a.data) >= inicioMes)
      .reduce((sum, a) => sum + a.preco, 0);

    document.getElementById('saldoDia').textContent = `R$ ${saldoDia}`;
    document.getElementById('saldoSemana').textContent = `R$ ${saldoSemana}`;
    document.getElementById('saldoMes').textContent = `R$ ${saldoMes}`;
    document.getElementById('totalAgendamentos').textContent = agendamentos.length;

    atualizarGraficos(agendamentos, saldoDia, saldoSemana, saldoMes);

    renderizarLista('pendente', 'listaPendentes');
    renderizarLista('confirmado', 'listaConfirmados');
    renderizarLista('concluido', 'listaConcluidos');
  }

  function atualizarGraficos(agendamentos, saldoDia, saldoSemana, saldoMes) {
    const ctxFaturamento = document.getElementById('chartFaturamento').getContext('2d');
    if (chartFaturamento) chartFaturamento.destroy();
    
    chartFaturamento = new Chart(ctxFaturamento, {
      type: 'bar',
      data: {
        labels: ['Dia', 'Semana', 'Mês'],
        datasets: [{
          label: 'Faturamento (R$)',
          data: [saldoDia, saldoSemana, saldoMes],
          backgroundColor: [
            'rgba(225, 6, 0, 0.8)',
            'rgba(225, 6, 0, 0.6)',
            'rgba(225, 6, 0, 0.4)'
          ],
          borderColor: '#e10600',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { labels: { color: '#f5f5f5' } }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { color: '#888' },
            grid: { color: 'rgba(255,255,255,0.1)' }
          },
          x: {
            ticks: { color: '#888' },
            grid: { color: 'rgba(255,255,255,0.1)' }
          }
        }
      }
    });

    const servicos = {};
    agendamentos.forEach(a => {
      servicos[a.servico] = (servicos[a.servico] || 0) + 1;
    });

    const ctxServicos = document.getElementById('chartServicos').getContext('2d');
    if (chartServicos) chartServicos.destroy();

    chartServicos = new Chart(ctxServicos, {
      type: 'doughnut',
      data: {
        labels: Object.keys(servicos).length > 0 ? Object.keys(servicos) : ['Sem dados'],
        datasets: [{
          data: Object.values(servicos).length > 0 ? Object.values(servicos) : [1],
          backgroundColor: [
            '#e10600',
            '#a00400',
            '#ff4444',
            '#888888'
          ],
          borderColor: '#0a0a0a',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { 
            position: 'bottom',
            labels: { color: '#f5f5f5' }
          }
        }
      }
    });
  }

  function renderizarLista(status, elementoId) {
    const agendamentos = getAgendamentos().filter(a => a.status === status);
    const container = document.getElementById(elementoId);
    
    if (agendamentos.length === 0) {
      container.innerHTML = '<p style="color:var(--cinza);">Nenhum agendamento</p>';
      return;
    }

    container.innerHTML = agendamentos.map(a => `
      <div class="agendamento-item">
        <div class="agendamento-info">
          <h4>${a.nome}</h4>
          <p><strong>Serviço:</strong> ${a.servico} - R$ ${a.preco}</p>
          <p><strong>Data:</strong> ${formatarData(a.data)} às ${a.hora}</p>
          <p><strong>Telefone:</strong> ${a.telefone}</p>
          ${a.observacoes ? `<p><strong>Obs:</strong> ${a.observacoes}</p>` : ''}
        </div>
        <div class="agendamento-actions">
          ${status === 'pendente' ? `
            <button class="btn-confirmar" onclick="confirmarAgendamento(${a.id})">Confirmar</button>
            <button class="btn-cancelar" onclick="cancelarAgendamento(${a.id})">Cancelar</button>
          ` : ''}
          ${status === 'confirmado' ? `
            <button class="btn-concluir" onclick="concluirAgendamento(${a.id})">Concluir</button>
          ` : ''}
          <button class="btn-excluir" onclick="excluirAgendamento(${a.id})">Excluir</button>
        </div>
      </div>
    `).join('');
  }

  function formatarData(data) {
    const [ano, mes, dia] = data.split('-');
    return `${dia}/${mes}/${ano}`;
  }

  function confirmarAgendamento(id) {
    const agendamentos = getAgendamentos();
    const agendamento = agendamentos.find(a => a.id === id);
    agendamento.status = 'confirmado';
    saveAgendamentos(agendamentos);
    carregarDashboard();
  }

  function concluirAgendamento(id) {
    const agendamentos = getAgendamentos();
    const agendamento = agendamentos.find(a => a.id === id);
    agendamento.status = 'concluido';
    saveAgendamentos(agendamentos);
    carregarDashboard();
  }

  function cancelarAgendamento(id) {
    if (confirm('Tem certeza que deseja cancelar este agendamento?')) {
      const agendamentos = getAgendamentos().filter(a => a.id !== id);
      saveAgendamentos(agendamentos);
      carregarDashboard();
    }
  }

  function excluirAgendamento(id) {
    if (confirm('Tem certeza que deseja EXCLUIR permanentemente este agendamento?')) {
      const agendamentos = getAgendamentos().filter(a => a.id !== id);
      saveAgendamentos(agendamentos);
      carregarDashboard();
    }
  }

  document.getElementById('data').min = new Date().toISOString().split('T')[0];
</script>

</body>
</html>
