<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Black Barber</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --black:#0b0b0c; --black2:#151513; --gold:#b3241c; --gold-l:#e2453a;
  --cream:#f2ede1; --gray:#8f8b80;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%}
body{
  background:var(--black); color:var(--cream);
  font-family:'Inter',sans-serif;
  -webkit-font-smoothing:antialiased;
}
h1,h2,.logo{font-family:'Bebas Neue',sans-serif; letter-spacing:2px}

/* ---------- HERO ---------- */
.hero{
  min-height:100vh; position:relative; display:flex; flex-direction:column;
  align-items:center; justify-content:center; text-align:center;
  padding:24px; overflow:hidden; background:#0b0b0c;
}
.hero::before{
  content:""; position:absolute; inset:0;
  background:linear-gradient(180deg, rgba(0,0,0,.5), rgba(0,0,0,.88));
  pointer-events:none; z-index:1;
}
.hero-bg{
  position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
  filter:grayscale(1) contrast(1.15) brightness(.6);
}
.hero-pole{width:64px;height:64px;margin-bottom:18px;position:relative;z-index:2}
.hero h1{
  font-size:clamp(3.2rem,14vw,7rem); color:var(--cream);
  line-height:.9; position:relative; z-index:2;
}
.hero h1 span{color:var(--gold)}
.hero p{
  color:var(--gray); font-size:1.05rem; margin-top:14px; max-width:420px;
  position:relative; z-index:2;
}
.btn-gold{
  margin-top:34px; background:var(--gold); color:var(--black);
  border:none; padding:16px 38px; font-family:'Bebas Neue',sans-serif;
  font-size:1.2rem; letter-spacing:2px; border-radius:2px; cursor:pointer;
  position:relative; z-index:2; transition:background .2s, transform .2s;
}
.btn-gold:hover{background:var(--gold-l); transform:translateY(-2px)}
.btn-gold:focus-visible{outline:3px solid var(--gold-l); outline-offset:3px}

/* ---------- SERVICOS ---------- */
.section{padding:70px 20px; max-width:1080px; margin:0 auto}
.section h2{font-size:2.6rem; text-align:center; color:var(--cream); margin-bottom:8px}
.section .sub{text-align:center; color:var(--gray); margin-bottom:40px}
.cards{display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:24px}
.card{
  background:var(--black2); border:1px solid #2a2a26; border-radius:4px;
  padding:0; overflow:hidden; display:flex; flex-direction:column;
}
.card-art{
  height:160px; display:flex; align-items:center; justify-content:center;
  background:linear-gradient(160deg,#1c1414,#0b0b0c);
  border-bottom:1px solid #2a2a26; overflow:hidden; position:relative;
}
.card-art img{width:100%; height:100%; object-fit:cover; filter:grayscale(1) contrast(1.1) brightness(.85)}
.card-art svg{width:56px;height:56px;stroke:var(--gold)}
.card-body{padding:22px; display:flex; flex-direction:column; flex:1}
.card-body h3{font-family:'Bebas Neue'; font-size:1.5rem; letter-spacing:1px; color:var(--cream)}
.card-price{color:var(--gold); font-size:1.6rem; font-weight:700; margin:10px 0 18px}
.card-price small{color:var(--gray); font-size:.9rem; font-weight:400}
.card-body button{
  margin-top:auto; background:transparent; color:var(--gold); border:1px solid var(--gold);
  padding:12px; font-family:'Bebas Neue'; letter-spacing:1.5px; font-size:1rem;
  border-radius:2px; cursor:pointer; transition:.2s;
}
.card-body button:hover{background:var(--gold); color:var(--black)}

/* ---------- MODAL ---------- */
.overlay{
  position:fixed; inset:0; background:rgba(0,0,0,.75); display:none;
  align-items:center; justify-content:center; padding:20px; z-index:50;
}
.overlay.open{display:flex}
.modal{
  background:var(--black2); border:1px solid var(--gold); border-radius:6px;
  padding:28px; width:100%; max-width:380px; max-height:90vh; overflow-y:auto;
}
.modal h3{font-family:'Bebas Neue'; font-size:1.8rem; color:var(--gold); margin-bottom:18px}
.field{margin-bottom:14px}
.field label{display:block; font-size:.85rem; color:var(--gray); margin-bottom:5px}
.field input,.field select{
  width:100%; padding:11px; background:#0b0b0c; border:1px solid #33322c;
  color:var(--cream); border-radius:3px; font-size:1rem;
}
.field input:focus,.field select:focus{outline:2px solid var(--gold)}
.modal-actions{display:flex; gap:10px; margin-top:20px}
.modal-actions button{flex:1; padding:13px; border:none; border-radius:3px; font-family:'Bebas Neue'; letter-spacing:1px; font-size:1rem; cursor:pointer}
.btn-confirm{background:var(--gold); color:var(--black)}
.btn-cancel{background:transparent; color:var(--gray); border:1px solid #33322c !important}
.msg-ok{color:#7fd18a; font-size:.9rem; margin-top:10px; text-align:center}

/* ---------- ADMIN ---------- */
.lock-btn{
  position:fixed; bottom:calc(16px + env(safe-area-inset-bottom,0px)); right:16px;
  width:42px; height:42px; border-radius:50%; background:var(--black2);
  border:1px solid #2a2a26; color:var(--gray); font-size:1.1rem; cursor:pointer; z-index:40;
  display:flex; align-items:center; justify-content:center; opacity:.55;
}
.lock-btn:hover{opacity:1}
.admin-modal{max-width:640px}
.admin-list{margin-top:16px; display:flex; flex-direction:column; gap:10px}
.appt{
  background:#0b0b0c; border:1px solid #2a2a26; border-radius:4px; padding:12px 14px;
  display:flex; flex-wrap:wrap; gap:8px 14px; align-items:center; font-size:.88rem;
}
.appt b{color:var(--cream)}
.appt .meta{color:var(--gray)}
.appt select{margin-left:auto; background:#151513; color:var(--cream); border:1px solid #33322c; border-radius:3px; padding:5px}
.appt .del{background:none; border:none; color:#d9645a; cursor:pointer; font-size:1rem}
.status-btn{margin-left:auto; background:var(--gold); color:#fff; border:none; padding:8px 14px; border-radius:3px; font-family:'Bebas Neue'; letter-spacing:1px; cursor:pointer}
.status-badge{margin-left:auto; padding:6px 12px; border-radius:3px; font-size:.8rem; font-weight:600}
.status-badge.done{background:#1f3a24; color:#7fd18a}
.status-badge.cancel{background:#3a1f1f; color:#e2453a}
.cancel-link{background:none; border:none; color:var(--gray); font-size:.8rem; cursor:pointer; text-decoration:underline}
.admin-actions{display:flex; justify-content:space-between; margin-top:16px; gap:10px}
.admin-actions button{padding:10px 16px; border-radius:3px; font-family:'Bebas Neue'; letter-spacing:1px; cursor:pointer; border:1px solid #33322c; background:transparent; color:var(--gray)}
.admin-actions .clear{color:#d9645a; border-color:#d9645a}
.empty{color:var(--gray); text-align:center; padding:20px 0}
.tabs{display:flex; gap:8px; margin-bottom:14px}
.tab-btn{flex:1; padding:10px; background:transparent; border:1px solid #33322c; color:var(--gray); font-family:'Bebas Neue'; letter-spacing:1px; border-radius:3px; cursor:pointer}
.tab-btn.active{background:var(--gold); color:var(--black); border-color:var(--gold)}
.saldo-box{background:#0b0b0c; border:1px solid var(--gold); border-radius:4px; padding:14px 18px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center}
.saldo-box b{color:var(--gold); font-size:1.5rem; font-family:'Bebas Neue'}
table.fin-table{width:100%; border-collapse:collapse; font-size:.9rem}
table.fin-table th,table.fin-table td{padding:10px 8px; text-align:left; border-bottom:1px solid #2a2a26}
table.fin-table th{color:var(--gray); font-weight:600}
table.fin-table td b{color:var(--gold)}

/* ---------- ADMIN FULLSCREEN ---------- */
.admin-screen{
  position:fixed; inset:0; background:var(--black); z-index:60; display:none;
  overflow-y:auto;
  padding:calc(20px + env(safe-area-inset-top,0px)) 20px calc(20px + env(safe-area-inset-bottom,0px));
}
.admin-screen.open{display:block}
.admin-wrap{max-width:680px; margin:0 auto}
.admin-header{display:flex; justify-content:space-between; align-items:center; margin-bottom:20px}
.admin-header h2{font-size:2rem; color:var(--gold)}
.admin-close{background:none; border:1px solid #33322c; color:var(--gray); width:36px; height:36px; border-radius:50%; cursor:pointer; font-size:1rem}

@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<section class="hero">
  <img class="hero-bg" src="data:image/jpeg;base64," alt="">
  <svg class="hero-pole" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.4">
    <rect x="6" y="2" width="12" height="20" rx="6"/>
    <path d="M6 6 L18 10 M6 10 L18 14 M6 14 L18 18" stroke="var(--cream)"/>
  </svg>
  <h1>BLACK<br><span>BARBER</span></h1>
  <p>Corte de precisão, atendimento de respeito. Reserve seu horário.</p>
  <button class="btn-gold" onclick="document.getElementById('servicos').scrollIntoView({behavior:'smooth'})">AGENDAR AGORA</button>
</section>

<section class="section" id="servicos">
  <h2>Serviços</h2>
  <p class="sub">Escolha e reserve em segundos</p>
  <div class="cards" id="cardsBox"></div>
</section>

<!-- BOOKING MODAL -->
<div class="overlay" id="bookingOverlay">
  <div class="modal">
    <h3 id="bookingTitle">Agendar</h3>
    <form id="bookingForm">
      <div class="field"><label>Nome</label><input type="text" id="bkNome" required></div>
      <div class="field"><label>Telefone</label><input type="tel" id="bkTel" placeholder="(00) 00000-0000" required></div>
      <div class="field"><label>Data</label><input type="date" id="bkData" required></div>
      <div class="field"><label>Horário</label><input type="time" id="bkHora" required></div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeBooking()">Cancelar</button>
        <button type="submit" class="btn-confirm">Confirmar</button>
      </div>
      <p class="msg-ok" id="bkMsg" style="display:none">Agendamento confirmado! ✅</p>
    </form>
  </div>
</div>

<button class="lock-btn" onclick="openAdminLogin()" aria-label="Painel administrativo">🔒</button>

<!-- ADMIN LOGIN -->
<div class="overlay" id="adminLoginOverlay">
  <div class="modal">
    <h3>Painel Admin</h3>
    <div class="field"><label>Senha</label><input type="password" id="adminPass" autocomplete="off"></div>
    <p class="msg-ok" id="adminErr" style="display:none;color:#d9645a">Senha incorreta.</p>
    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeAdminLogin()">Cancelar</button>
      <button class="btn-confirm" onclick="checkAdmin()">Entrar</button>
    </div>
  </div>
</div>

<!-- ADMIN PANEL (tela cheia) -->
<div class="admin-screen" id="adminPanelOverlay">
  <div class="admin-wrap">
    <div class="admin-header">
      <h2>Painel Admin</h2>
      <button class="admin-close" onclick="closeAdminPanel()" aria-label="Fechar">✕</button>
    </div>
    <div class="tabs">
      <button class="tab-btn active" id="tabAg" onclick="showTab('ag')">Agendamentos</button>
      <button class="tab-btn" id="tabFin" onclick="showTab('fin')">Financeiro</button>
    </div>
    <div id="paneAg">
      <div class="admin-list" id="adminList"></div>
    </div>
    <div id="paneFin" style="display:none">
      <div class="saldo-box"><span>Saldo total (confirmados + concluídos)</span><b id="saldoTotal">R$ 0</b></div>
      <table class="fin-table">
        <thead><tr><th>Mês</th><th>Atendimentos</th><th>Faturamento</th></tr></thead>
        <tbody id="finBody"></tbody>
      </table>
    </div>
    <div class="admin-actions">
      <button class="clear" onclick="clearAll()">Apagar todos</button>
    </div>
  </div>
</div>

<script>
