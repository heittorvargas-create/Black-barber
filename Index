<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Black Barber - Barbearia Premium</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
  :root {
    --preto: #0a0a0a;
    --preto-2: #151515;
    --vermelho: #e10600;
    --vermelho-escuro: #a00400;
    --branco: #f5f5f5;
    --cinza: #888;
    --verde: #25d366;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--preto);
    color: var(--branco);
    overflow-x: hidden;
  }

  h1, h2, h3 { font-family: 'Bebas Neue', sans-serif; letter-spacing: 2px; }

  /* NAVBAR */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(10,10,10,0.95);
    backdrop-filter: blur(10px);
    z-index: 1000;
    border-bottom: 1px solid rgba(225,6,0,0.2);
  }
  .logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem;
    color: var(--branco);
  }
  .logo span { color: var(--vermelho); }
  .nav-links { display: flex; gap: 30px; list-style: none; }
  .nav-links a {
    color: var(--branco);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    transition: color 0.3s;
    position: relative;
  }
  .nav-links a:hover { color: var(--vermelho); }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -5px; left: 0;
    width: 0; height: 2px;
    background: var(--vermelho);
    transition: width 0.3s;
  }
  .nav-links a:hover::after { width: 100%; }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none; border: none;
  }
  .menu-toggle span {
    width: 25px; height: 3px;
    background: var(--branco);
    transition: 0.3s;
  }

  /* HERO */
  .hero {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    background: var(--preto);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1512690459250-6c2711632043?w=1920&q=80');
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.6);
    z-index: 1;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 50%, rgba(225,6,0,0.2) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(225,6,0,0.15) 0%, transparent 50%);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(225,6,0,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(225,6,0,0.05) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: moveGrid 20s linear infinite;
    z-index: 2;
  }
  @keyframes moveGrid {
    0% { transform: translate(0,0); }
    100% { transform: translate(50px,50px); }
  }
  .hero-content { position: relative; z-index: 3; padding: 0 20px; }
  .hero h1 {
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 1;
    margin-bottom: 20px;
    animation: fadeUp 1s ease;
    text-shadow: 2px 2px 10px rgba(0,0,0,0.8);
  }
  .hero h1 span { color: var(--vermelho); }
  .hero p {
    font-size: 1.2rem;
    color: var(--branco);
    margin-bottom: 40px;
    animation: fadeUp 1s ease 0.2s backwards;
    text-shadow: 1px 1px 5px rgba(0,0,0,0.8);
  }
  .btn {
    display: inline-block;
    padding: 15px 40px;
    background: var(--vermelho);
    color: var(--branco);
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    border: 2px solid var(--vermelho);
    transition: all 0.3s;
    cursor: pointer;
    animation: fadeUp 1s ease 0.4s backwards;
  }
  .btn:hover {
    background: transparent;
    color: var(--vermelho);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(225,6,0,0.3);
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* SEÇÕES GERAIS */
  section { padding: 100px 8%; }
  .section-title {
    text-align: center;
    margin-bottom: 60px;
  }
  .section-title h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 10px;
  }
  .section-title h2 span { color: var(--vermelho); }
  .section-title p { color: var(--cinza); }

  /* SOBRE */
  .sobre {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    background: var(--preto-2);
  }
  .sobre-img {
    height: 400px;
    background-image: url('https://images.unsplash.com/photo-1585747860715-2ba37e788b70?w=800&q=80');
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.7);
    border: 2px solid var(--vermelho);
    position: relative;
  }
  .sobre-text h2 { font-size: 3rem; margin-bottom: 20px; }
  .sobre-text h2 span { color: var(--vermelho); }
  .sobre-text p { color: var(--cinza); line-height: 1.8; margin-bottom: 20px; }

  /* SERVIÇOS */
  .servicos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }
  .servico-card {
    background: var(--preto-2);
    border: 1px solid rgba(255,255,255,0.05);
    transition: all 0.4s;
    position: relative;
    overflow: hidden;
  }
  .servico-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 3px;
    background: var(--vermelho);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s;
  }
  .servico-card:hover::before { transform: scaleX(1); }
  .servico-card:hover {
    transform: translateY(-10px);
    border-color: var(--vermelho);
  }
  .servico-img {
    height: 200px;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.6);
    transition: filter 0.4s;
  }
  .servico-card:hover .servico-img {
    filter: grayscale(0%) brightness(0.8);
  }
  .servico-content {
    padding: 30px;
  }
  .servico-card h3 {
    font-size: 1.8rem;
    margin-bottom: 15px;
  }
  .servico-card p {
    color: var(--cinza);
    margin-bottom: 20px;
    line-height: 1.6;
  }
  .servico-card .preco {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    color: var(--vermelho);
  }

  /* GALERIA */
  .galeria { background: var(--preto-2); }
  .galeria-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 15px;
  }
  .galeria-item {
    height: 250px;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.7);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid rgba(225,6,0,0.1);
    transition: all 0.4s;
  }
  .galeria-item:hover {
    filter: grayscale(0%) brightness(0.9);
    border-color: var(--vermelho);
    transform: scale(1.03);
  }
  .galeria-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 50%, rgba(225,6,0,0.3));
    opacity: 0;
    transition: opacity 0.4s;
  }
  .galeria-item:hover::after { opacity: 1; }

  /* DEPOIMENTOS */
  .depoimentos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  .depoimento {
    background: var(--preto-2);
    padding: 30px;
    border-left: 3px solid var(--vermelho);
  }
  .depoimento p {
    font-style: italic;
    color: var(--cinza);
    margin-bottom: 20px;
    line-height: 1.6;
  }
  .depoimento .autor {
    color: var(--vermelho);
    font-weight: 700;
  }
  .estrelas { color: #ffc107; margin-bottom: 15px; }

  /* AGENDAMENTO */
  .agendamento {
    background:
      linear-gradient(rgba(10,10,10,0.9), rgba(10,10,10,0.9)),
      radial-gradient(circle at center, rgba(225,6,0,0.2), transparent);
  }
  form {
    max-width: 600px;
    margin: 0 auto;
    display: grid;
    gap: 20px;
  }
  form input, form select, form textarea {
    padding: 15px;
    background: var(--preto-2);
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--branco);
    font-family: inherit;
    font-size: 1rem;
    transition: border 0.3s;
  }
  form input:focus, form select:focus, form textarea:focus {
    outline: none;
    border-color: var(--vermelho);
  }
  form textarea { min-height: 120px; resize: vertical; }

  /* FOOTER */
  footer {
    background: #050505;
    padding: 40px 8%;
    text-align: center;
    border-top: 1px solid rgba(225,6,0,0.2);
    position: relative;
  }
  footer .social {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
  }
  footer .social a {
    width: 45px; height: 45px;
    border: 1px solid var(--vermelho);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vermelho);
    text-decoration: none;
    transition: all 0.3s;
  }
  footer .social a:hover {
    background: var(--vermelho);
    color: var(--branco);
  }
  footer p { color: var(--cinza); font-size: 0.9rem; }

  .admin-link {
    position: absolute;
    bottom: 20px;
    right: 20px;
    color: var(--cinza);
    text-decoration: none;
    font-size: 1.5rem;
    opacity: 0.3;
    transition: all 0.3s;
  }
  .admin-link:hover {
    opacity: 1;
    color: var(--vermelho);
    transform: scale(1.2);
  }

  /* MODAL LOGIN */
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.9);
    z-index: 2000;
    align-items: center;
    justify-content: center;
  }
  .modal.active { display: flex; }
  .modal-content {
    background: var(--preto-2);
    padding: 50px;
    border: 2px solid var(--vermelho);
    max-width: 400px;
    width: 90%;
    position: relative;
  }
  .modal-close {
    position: absolute;
    top: 15px; right: 20px;
    background: none;
    border: none;
    color: var(--branco);
    font-size: 2rem;
    cursor: pointer;
  }
  .modal-content h2 {
    text-align: center;
    margin-bottom: 30px;
    color: var(--vermelho);
  }
  .modal-content form input {
    width: 100%;
    margin-bottom: 20px;
  }

  /* PAINEL ADMIN */
  .admin-panel {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--preto);
    z-index: 2000;
    overflow-y: auto;
  }
  .admin-panel.active { display: block; }
  .admin-header {
    background: var(--preto-2);
    padding: 20px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--vermelho);
  }
  .admin-header h1 {
    font-size: 2rem;
    color: var(--vermelho);
  }
  .admin-header button {
    background: var(--vermelho);
    color: var(--branco);
    border: none;
    padding: 10px 25px;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
  }
  .admin-content {
    padding: 40px 5%;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  .stat-card {
    background: var(--preto-2);
    padding: 30px;
    border-left: 4px solid var(--vermelho);
  }
  .stat-card h3 {
    color: var(--cinza);
    font-size: 1rem;
    margin-bottom: 10px;
    font-family: 'Inter', sans-serif;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .stat-card .value {
    font-size: 2.5rem;
    color: var(--vermelho);
    font-family: 'Bebas Neue', sans-serif;
  }
  
  /* GRÁFICOS */
  .charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }
  .chart-container {
    background: var(--preto-2);
    padding: 30px;
    border: 1px solid rgba(225,6,0,0.2);
  }
  .chart-container h3 {
    color: var(--vermelho);
    margin-bottom: 20px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
  }

  .agendamentos-section {
    background: var(--preto-2);
    padding: 30px;
    margin-bottom: 30px;
  }
  .agendamentos-section h2 {
    margin-bottom: 20px;
    color: var(--vermelho);
  }
  .agendamento-item {
    background: var(--preto);
    padding: 20px;
    margin-bottom: 15px;
    border-left: 3px solid var(--vermelho);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: center;
  }
  .agendamento-info h4 {
    font-size: 1.3rem;
    margin-bottom: 5px;
  }
  .agendamento-info p {
    color: var(--cinza);
    font-size: 0.9rem;
    margin-bottom: 3px;
  }
  .agendamento-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .agendamento-actions button {
    padding: 10px 20px;
    border: none;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    font-size: 0.8rem;
    transition: all 0.3s;
  }
  .agendamento-actions button:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
  }
  .btn-confirmar {
    background: #ffa500;
    color: var(--preto);
  }
  .btn-concluir {
    background: var(--verde);
    color: var(--preto);
  }
  .btn-cancelar {
    background: var(--vermelho);
    color: var(--branco);
  }
  .btn-excluir {
    background: #333;
    color: var(--branco);
  }
  .btn-excluir:hover {
    background: #555;
  }
  .status-pendente { color: #ffa500; }
  .status-confirmado { color: var(--verde); }
  .status-concluido { color: var(--cinza); }

  /* REVEAL ANIMATION */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease;
  }
  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* RESPONSIVO */
  @media (max-width: 768px) {
    nav { padding: 15px 5%; }
    .menu-toggle { display: flex; }
    .nav-links {
      position: fixed;
      top: 70px; left: 0; right: 0;
      background: var(--preto);
      flex-direction: column;
      padding: 30px;
      gap: 20px;
      transform: translateY(-150%);
      transition: transform 0.4s;
    }
    .nav-links.active { transform: translateY(0); }
    section { padding: 70px 5%; }
    .sobre { grid-template-columns: 1fr; }
    .sobre-img { height: 250px; }
    .agendamento-item {
      grid-template-columns: 1fr;
    }
    .agendamento-actions {
      width: 100%;
    }
    .agendamento-actions button {
      flex: 1;
    }
    .charts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
</head>
<body>

<!-- NAVBAR -->
<nav>
  <div class="logo">BLACK<span>BARBER</span></div>
  <ul class="nav-links" id="navLinks">
    <li><a href="#home">Início</a></li>
    <li><a href="#sobre">Sobre</a></li>
    <li><a href="#servicos">Serviços</a></li>
    <li><a href="#galeria">Galeria</a></li>
    <li><a href="#agendar">Agendar</a></li>
  </ul>
  <button class="menu-toggle" id="menuToggle">
    <span></span><span></span><span></span>
