<section class="agendamento" id="agendar">
  <div class="section-title reveal">
    <h2>AGENDE SEU <span>HORÁRIO</span></h2>
    <p>Garanta seu lugar na agenda</p>
  </div>
  <form class="reveal" id="formAgendamento" onsubmit="criarAgendamento(event)">
    <input type="text" id="nome" placeholder="Seu nome" required>
    <input type="tel" id="telefone" placeholder="Telefone (11) 99999-9999" required>
    <select id="servico" required>
      <option value="">Escolha o serviço</option>
      <option value="Corte Masculino|50">Corte Masculino - R$ 50</option>
      <option value="Barba Completa|40">Barba Completa - R$ 40</option>
      <option value="Combo Premium|80">Combo Premium - R$ 80</option>
      <option value="Corte Infantil|35">Corte Infantil - R$ 35</option>
    </select>
    <input type="date" id="data" required>
    <input type="time" id="hora" required>
    <textarea id="observacoes" placeholder="Observações (opcional)"></textarea>
    <button type="submit" class="btn">Solicitar Agendamento</button>
  </form>
</section>

<!-- FOOTER -->
<footer>
  <div class="social">
    <a href="#" title="Instagram"></a>
    <a href="#" title="Facebook">f</a>
